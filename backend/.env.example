# --- Database ---
DATABASE_URL=postgresql+psycopg://supportsync:supportsync@localhost:5432/supportsync

# --- Redis (M3 Phase B: notification fan-out + rate limiting; fail-open) ---
REDIS_URL=redis://localhost:6379/0

# --- Security ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Bootstrap admin (used by seeds) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123!

# --- Confirmation emails (M4, ADR 0006) ---
EMAILS_ENABLED=true
EMAIL_BACKEND=console            # console | smtp
EMAIL_FROM=supportsync@example.com
# EMAIL_BACKEND=smtp needs:
# EMAIL_SMTP_HOST=localhost
# EMAIL_SMTP_PORT=25
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
